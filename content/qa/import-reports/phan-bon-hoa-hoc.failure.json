        "pathHint": "word/document.xml#body/p[9]",
        "sectionPath": "Phần I",
        "textAnchor": "Độ dinh dưỡng của phân là đại lượng được sử dụng để xác định hàm lượng các nguyên tố trong phân bón."
      }
