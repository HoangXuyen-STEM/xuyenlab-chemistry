# Public application origin. Keep localhost for local development.
APP_BASE_URL=http://localhost:3000

# Neon Postgres and Neon Auth (configured in Phase 3).
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Google OAuth through Neon Auth (configured in Phase 3).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated teacher email addresses; evaluated server-side only.
TEACHER_EMAILS=

# Cloudflare R2 (configured when storage integration starts).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=chem-assets-dev
R2_PRIVATE_BUCKET=chem-private-dev
R2_PUBLIC_BASE_URL=
